# Copy to .env and replace every placeholder before starting OmniRouter.
# Keep the gateway bound to loopback unless protected by a trusted TLS proxy.
OMNI_ADDR=127.0.0.1:8080
OMNI_DATABASE_PATH=./data/omnirouter.db
OMNI_DATABASE_BUSY_TIMEOUT=5s
OMNI_DATABASE_WAL=true

# Generate with: openssl rand -hex 32
OMNI_GATEWAY_API_KEY=replace-with-a-random-gateway-key

# Generate with: openssl rand -base64 32
# Required when OMNI_PROVIDER_API_KEY is non-empty.
OMNI_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

OMNI_PROVIDER_ID=deepseek
OMNI_PROVIDER_NAME=DeepSeek
OMNI_PROVIDER_BASE_URL=https://api.deepseek.com/v1
OMNI_PROVIDER_API_KEY=replace-with-your-provider-api-key
OMNI_PROVIDER_MODELS=deepseek-chat,deepseek-reasoner
# Capabilities are declarations used by routing filters; only declare real model features.
OMNI_PROVIDER_MODEL_CAPABILITIES='{"deepseek-chat":["chat","streaming","tools"],"deepseek-reasoner":["chat","streaming"]}'
